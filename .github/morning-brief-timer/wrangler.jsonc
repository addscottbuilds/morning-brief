{
  "name": "morning-brief-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": {
    // Cloudflare cron uses UTC. The Worker selects the Sydney times.
    "crons": ["40 19,20 * * *", "5 20,21 * * *", "0 0,1,20-23 * * *"]
  }
}
